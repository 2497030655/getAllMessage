# 复制为 cloud.env 后按需填写（勿提交真实密码/Token）

ALIYUN_HOST=你的服务器IP
ALIYUN_DOMAIN=你的域名
ALIYUN_SSH_USER=root
ALIYUN_INSTANCE_ID=你的ECS实例ID
ALIYUN_REGION=cn-beijing

CLOUD_HOST=0.0.0.0
CLOUD_PORT=8787
CLOUD_PARSE_WORKERS=4
CLOUD_API_TOKEN=请改成强随机字符串

# 留空则关闭上云；启用示例：
# CLOUD_WS_URL=ws://你的域名/im/ws/agent
# CLOUD_MOBILE_WS_URL=ws://你的域名/im/ws/mobile
# CLOUD_API_BASE=http://你的域名/im
CLOUD_WS_URL=
CLOUD_MOBILE_WS_URL=
CLOUD_API_BASE=
